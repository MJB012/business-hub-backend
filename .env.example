MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=business-hub
MONGODB_DB_NAME=business_hub
PORT=3000
JWT_SECRET=supersecret_jwt_key_business_hub

# Brevo (Sendinblue) SMTP Configuration
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_brevo_smtp_login_or_email
SMTP_PASS=your_brevo_smtp_key
SMTP_FROM="Business Hub" <no-reply@businesshub.com>

